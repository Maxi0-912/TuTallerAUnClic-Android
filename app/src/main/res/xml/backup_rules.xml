<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 y anteriores. allowBackup="false" ya desactiva el respaldo;
     esto es una segunda barrera: nunca respaldar sesion ni datos locales. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
